# Copy to .env and fill in. Never commit .env.
# With no Supabase or Gemini values set, the API runs with in-memory seed data
# and stubbed AI responses, so `npm run dev` works with zero configuration.

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:5173

# --- Data source ---
# "memory" (seed data, no database) or "supabase". Defaults to "supabase" when
# SUPABASE_URL and SUPABASE_SECRET_KEY are set, otherwise "memory".
DATA_SOURCE=

# --- Supabase (server side) ---
# Project URL, e.g. https://<project-ref>.supabase.co or http://127.0.0.1:54321 locally.
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role key. Server only: it bypasses
# Row Level Security. Never expose it to the frontend or prefix it with VITE_.
SUPABASE_SECRET_KEY=

# --- Google Gemini ---
# Leave empty to use stubbed scan/chat responses during development.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Local dev auth ---
# In memory mode, accepts "Authorization: Bearer dev:<user-id>" tokens so the
# frontend works without Supabase. Ignored when NODE_ENV=production.
ALLOW_DEV_AUTH=true
